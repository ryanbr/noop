    "%@ is %@ better than baseline on days you logged this behaviour.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist an Tagen mit diesem Verhalten %2$@ besser als die Basislinie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is %2$@ better than baseline on days you logged this behaviour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es %@ mejor que tu línea base en los días que registraste este hábito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est %2$@ meilleur que la référence les jours où vous avez enregistré ce comportement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è %@ migliore della linea di base nei giorni in cui hai registrato questo comportamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ é %2$@ melhor do que a referência nos dias em que registaste este comportamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ на %2$@ лучше нормы в дни, когда вы отмечали это поведение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你记录了该行为的日子里，%@ 比基线好 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你記錄這項行為的日子，%@ 比基線好 %@。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jest %2$@ lepszy niż poziom bazowy w dniach, w których rejestrowano to zachowanie."
          }
        }
      }
    },
    "%@ is %@ worse than baseline on days you logged this behaviour.": {
