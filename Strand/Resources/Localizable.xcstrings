    "Over your readings, %@ and %@ move largely independently. No clear relationship.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über deine Messwerte hinweg bewegen sich %1$@ und %2$@ weitgehend unabhängig. Kein klarer Zusammenhang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Over your readings, %1$@ and %2$@ move largely independently. No clear relationship."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tus lecturas, %@ y %@ se mueven en gran medida de forma independiente. Sin relación clara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur vos lectures, %1$@ et %2$@ évoluent en grande partie de façon indépendante. Aucune relation claire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelle tue letture, %@ e %@ si muovono in gran parte in modo indipendente. Nessuna relazione chiara."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao longo das tuas leituras, %1$@ e %2$@ movem-se de forma bastante independente. Sem relação clara."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ваших данных %1$@ и %2$@ в основном изменяются независимо друг от друга. Чёткой связи нет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的读数中，%@与%@基本各自变化。没有明显关联。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從你的讀數來看，%@ 和 %@ 大致上各走各的。沒有明顯關係。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W twoich odczytach %1$@ i %2$@ poruszają się w dużej mierze niezależnie. Brak jasnego związku."
          }
        }
      }
    },
