    "Locked %@ · paces drift, re-measure anytime.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixiert %@ · Tempi driften, jederzeit neu messbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado %@ · los ritmos varían, vuelve a medir cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillé %@ · les allures dérivent, remesurez à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloccato %@ · i ritmi cambiano, rimisura quando vuoi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado %@ · ritmos à deriva, meça novamente a qualquer momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зафиксировано %@ · темп со временем меняется, при необходимости измерьте заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已锁定 %@ · 节奏会漂移，可随时重新测量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已鎖定 %@ · 節奏會漂移，可隨時重新測量。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokowany %@ · dryf tempa, możliwość ponownego pomiaru w dowolnym momencie."
          }
        }
      }
    },
    "Locked %@. Switch to Breathe to use it, or re-measure above.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixiert %@. Wechsle zu „Atmen“, um es zu nutzen, oder miss oben neu."
          }
        },
        "es": {
          "stringUnit": {
