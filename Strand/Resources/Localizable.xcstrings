    "This never leaves your device unless you export a backup yourself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Daten verlassen dein Gerät nur, wenn du selbst ein Backup exportierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos datos solo salen de tu dispositivo si tú mismo exportas una copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces données ne quittent votre appareil que si vous exportez vous-même une sauvegarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi dati lasciano il tuo dispositivo solo se esporti personalmente un backup."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes dados só saem do teu dispositivo se exportares uma cópia de segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти данные покидают ваше устройство, только если вы сами экспортируете резервную копию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
