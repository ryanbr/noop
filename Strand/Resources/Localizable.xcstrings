            "state": "translated",
            "value": "Elige el anillo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir la bague"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli l'anello"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o anel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите кольцо"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择戒指"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇戒指"
          }
        },
        "pl": {
