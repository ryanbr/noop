            "value": "Cieplejszy niż poziom bazowy"
          }
        }
      }
    },
    "Warming up. Cues stay quiet for the first minute.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufwärmen. In der ersten Minute bleiben die Hinweise still."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calentando. Los avisos permanecen en silencio durante el primer minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échauffement. Les signaux restent silencieux pendant la première minute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riscaldamento. I segnali restano silenziosi per il primo minuto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquecendo. As dicas ficam em silêncio no primeiro minuto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разминка. Подсказки молчат первую минуту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热身中。前一分钟内不会发出提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "熱身中。前一分鐘內不會發出提示。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozgrzewka. Sygnały pozostają ciche przez pierwszą minutę."
          }
        }
      }
    },
    "Warming up. Keep moving to climb into Zone 1.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufwärmen. Beweg dich weiter, um in Zone 1 zu kommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
