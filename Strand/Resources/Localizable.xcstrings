    } },
    "Your body clock looks aligned with your schedule.": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Deine innere Uhr scheint zu deinem Zeitplan zu passen." } }, "en": { "stringUnit": { "state": "translated", "value": "Your body clock looks aligned with your schedule." } }, "es": { "stringUnit": { "state": "translated", "value": "Tu reloj biológico parece estar alineado con tu horario." } }, "fr": { "stringUnit": { "state": "translated", "value": "Votre horloge biologique semble alignée sur votre emploi du temps." } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "O teu relógio biológico parece alinhado com o teu horário." } },
      "it": { "stringUnit": { "state": "translated", "value": "O teu relógio biológico parece alinhado com o teu horário." } },
      "pl": { "stringUnit": { "state": "translated", "value": "O teu relógio biológico parece alinhado com o teu horário." } },
      "ru": { "stringUnit": { "state": "translated", "value": "O teu relógio biológico parece alinhado com o teu horário." } },
      "zh-Hans": { "stringUnit": { "state": "translated", "value": "O teu relógio biológico parece alinhado com o teu horário." } },
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "O teu relógio biológico parece alinhado com o teu horário." } }
    } },
    "Shifting your clock %@ h earlier, about an hour a day. Light and sleep timing only.": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Deine innere Uhr wird um %@ Std. nach vorn verschoben, etwa eine Stunde pro Tag. Nur Licht- und Schlafzeiten." } }, "en": { "stringUnit": { "state": "translated", "value": "Shifting your clock %@ h earlier, about an hour a day. Light and sleep timing only." } }, "es": { "stringUnit": { "state": "translated", "value": "Adelanta tu reloj %@ h, aproximadamente una hora al día. Solo se ajustan la luz y los horarios de sueño." } }, "fr": { "stringUnit": { "state": "translated", "value": "Avance de votre horloge de %@ h, environ une heure par jour. Uniquement la lumière et les horaires de sommeil." } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "Adianta o teu relógio %@ h, cerca de uma hora por dia. Apenas luz e horários de sono." } },
      "it": { "stringUnit": { "state": "translated", "value": "Adianta o teu relógio %@ h, cerca de uma hora por dia. Apenas luz e horários de sono." } },
      "pl": { "stringUnit": { "state": "translated", "value": "Adianta o teu relógio %@ h, cerca de uma hora por dia. Apenas luz e horários de sono." } },
      "ru": { "stringUnit": { "state": "translated", "value": "Adianta o teu relógio %@ h, cerca de uma hora por dia. Apenas luz e horários de sono." } },
      "zh-Hans": { "stringUnit": { "state": "translated", "value": "Adianta o teu relógio %@ h, cerca de uma hora por dia. Apenas luz e horários de sono." } },
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "Adianta o teu relógio %@ h, cerca de uma hora por dia. Apenas luz e horários de sono." } }
    } },
    "Shifting your clock %@ h later, about an hour a day. Light and sleep timing only.": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Deine innere Uhr wird um %@ Std. nach hinten verschoben, etwa eine Stunde pro Tag. Nur Licht- und Schlafzeiten." } }, "en": { "stringUnit": { "state": "translated", "value": "Shifting your clock %@ h later, about an hour a day. Light and sleep timing only." } }, "es": { "stringUnit": { "state": "translated", "value": "Retrasa tu reloj %@ h, aproximadamente una hora al día. Solo se ajustan la luz y los horarios de sueño." } }, "fr": { "stringUnit": { "state": "translated", "value": "Retarde votre horloge de %@ h, environ une heure par jour. Uniquement la lumière et les horaires de sommeil." } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "Atrasa o teu relógio %@ h, cerca de uma hora por dia. Apenas luz e horários de sono." } },
      "it": { "stringUnit": { "state": "translated", "value": "Atrasa o teu relógio %@ h, cerca de uma hora por dia. Apenas luz e horários de sono." } },
      "pl": { "stringUnit": { "state": "translated", "value": "Atrasa o teu relógio %@ h, cerca de uma hora por dia. Apenas luz e horários de sono." } },
