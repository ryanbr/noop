    "Dose-response curve. Each extra %@ lines up with about %@ on %@, typical patterns.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosis-Wirkungs-Kurve. Jedes zusätzliche %1$@ geht mit etwa %2$@ bei %3$@ einher, typische Muster."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Dose-response curve. Each extra %1$@ lines up with about %2$@ on %3$@, typical patterns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva de dosis-respuesta. Cada %@ extra se corresponde con aproximadamente %@ en %@, patrones típicos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courbe dose-réponse. Chaque %1$@ supplémentaire correspond à environ %2$@ sur %3$@, schémas typiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva dose-risposta. Ogni %@ in più corrisponde a circa %@ su %@, schemi tipici."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva dose-resposta. Cada %1$@ extra alinha-se com cerca de %2$@ em %3$@, padrões típicos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кривая «доза-эффект». Каждый дополнительный %1$@ соответствует примерно %2$@ по показателю %3$@ — типичные закономерности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剂量反应曲线。每多 %1$@，大约对应 %3$@ 上 %2$@ 的变化，典型模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "劑量反應曲線。每多 %1$@，大約對應 %3$@ 上 %2$@ 的變化，屬於典型模式。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krzywa dawka-odpowiedź. Każdy dodatkowy %1$@ pokrywa się z około %2$@ na %3$@, typowymi wzorami."
          }
        }
      }
    },
    "Dose-response curve. Each extra %@ lines up with about %@ on %@, your own data.": {
      "localizations": {
