      "zh-Hant": { "stringUnit": { "state": "translated", "value": "O teu relógio biológico parece mais tardio, com tendência noturna." } }
    } },
    "Your body clock looks earlier, with a morning tendency.": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Deine innere Uhr scheint früher zu laufen – mit einer Tendenz zum Morgenmenschen." } }, "en": { "stringUnit": { "state": "translated", "value": "Your body clock looks earlier, with a morning tendency." } }, "es": { "stringUnit": { "state": "translated", "value": "Tu reloj biológico parece más temprano, con tendencia matutina." } }, "fr": { "stringUnit": { "state": "translated", "value": "Votre horloge biologique semble plus précoce, avec une tendance matinale." } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "O teu relógio biológico parece mais adiantado, com tendência matinal." } },
      "it": { "stringUnit": { "state": "translated", "value": "O teu relógio biológico parece mais adiantado, com tendência matinal." } },
      "pl": { "stringUnit": { "state": "translated", "value": "O teu relógio biológico parece mais adiantado, com tendência matinal." } },
      "ru": { "stringUnit": { "state": "translated", "value": "O teu relógio biológico parece mais adiantado, com tendência matinal." } },
