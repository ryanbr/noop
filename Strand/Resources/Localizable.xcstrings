    "Pair and manage the bands NOOP reads from.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopple und verwalte die Bänder, von denen NOOP liest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareja y gestiona las bandas de las que NOOP lee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez et gérez les bandes dont NOOP tire ses lectures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbina e gestisci le fasce da cui NOOP legge."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Emparelhe e gerencie as bandas a partir das quais o NOOP lê."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сопрягайте и управляйте браслетами, с которых NOOP считывает данные."
          }
        },
        "zh-Hans": {
          "stringUnit": {
