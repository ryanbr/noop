    "low - similar strain every day raises strain/illness risk": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "niedrig - ähnliche Belastung an jedem Tag erhöht das Risiko für Überlastung/Krankheit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "baja: un esfuerzo similar cada día aumenta el riesgo de sobrecarga o enfermedad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "faible - un effort similaire chaque jour augmente le risque de surcharge/maladie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "bassa - uno sforzo simile ogni giorno aumenta il rischio di sovraccarico/malattia"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "baixo - tensão semelhante todos os dias aumenta o risco de tensão/doença"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "низкая - одинаковая нагрузка изо дня в день повышает риск избыточной нагрузки или болезни"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "偏低——每天强度雷同会增加过度负荷/患病风险"
