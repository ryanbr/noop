          "stringUnit": {
            "state": "translated",
            "value": "Ночей с данными о сне пока нет. История будет пополняться по мере того, как вы носите браслет во время сна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无有睡眠数据的夜晚，随着你佩戴手环入睡，你的记录会逐渐填满。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
