          }
        }
      }
    },
    "Wear the strap, tap once, then let it sync and share your strap log.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage den Strap, tippe einmal, lass ihn dann synchronisieren und teile dein Strap-Log."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte la pulsera, toca una vez, luego deja que sincronice y comparte el registro de tu pulsera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portez le bracelet, touchez une fois, laissez-le se synchroniser puis partagez le journal de votre bracelet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indossa la fascia, tocca una volta, poi lasciala sincronizzare e condividi il log della fascia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a bracelete, toque uma vez e deixe-a sincronizar e partilhar o registo da bracelete."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наденьте браслет, нажмите один раз, затем дайте ему синхронизироваться и поделитесь журналом браслета."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "佩戴手环，点按一次，然后让它同步并分享你的手环日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "戴上手環，點一下，等它同步後分享你的手環記錄檔。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Załóż pasek, dotknij raz, a następnie pozwól mu się zsynchronizować i udostępnij dziennik paska."
          }
        }
      }
    },
