    "Train by feel. The strap buzzes so you don't have to watch a screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainiere nach Gefühl. Der Strap vibriert, damit du nicht auf einen Bildschirm schauen musst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrena por sensaciones. La pulsera vibra para que no tengas que mirar una pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraînez-vous au ressenti. Le bracelet vibre pour que vous n'ayez pas à regarder un écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allenati a sensazione. La fascia vibra così non devi guardare uno schermo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Treine pelo sentimento. A bracelete vibra para que não tenha de assistir a um ecrã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренируйтесь по ощущениям. Браслет вибрирует, чтобы вам не нужно было смотреть на экран."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凭感觉训练。手环会震动提醒，你无需盯着屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憑感覺訓練。手環會震動，你不必盯著螢幕。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenuj na wyczucie. Pasek brzęczy, więc nie musisz patrzeć na ekran."
          }
        }
      }
    },
