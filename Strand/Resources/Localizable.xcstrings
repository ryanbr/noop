    "Tag a few sessions of the same activity and NOOP will learn its personal recovery cost.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere ein paar Sitzungen derselben Aktivität, und NOOP lernt ihre persönlichen Erholungskosten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiqueta unas cuantas sesiones de la misma actividad y NOOP aprenderá su costo de recuperación personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étiquetez quelques séances de la même activité et NOOP apprendra son coût de récupération personnel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Etichetta alcune sessioni della stessa attività e NOOP imparerà il suo costo di recupero personale."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque algumas sessões da mesma atividade e o NOOP aprenderá o teu custo de recuperação pessoal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте несколько тренировок одного вида активности, и NOOP определит их индивидуальную стоимость восстановления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为几次相同活动的会话打上标签，NOOP 便会学习它对你个人的恢复消耗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為幾次相同活動的工作階段打上標籤，NOOP 便會學習它對你個人的恢復消耗。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz kilka sesji tej samej czynności, a NOOP pozna osobisty koszt odzyskiwania."
          }
        }
      }
    },
    "Take a 60-second seated HRV reading from the live R-R stream.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach eine 60-Sekunden-HRV-Messung im Sitzen aus dem Live-R-R-Stream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma una lectura de VFC de 60 segundos, sentado, a partir de la transmisión R-R en vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effectuez une lecture de VFC de 60 secondes, assis, à partir du flux R-R en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Effettua una lettura HRV da seduto di 60 secondi dal flusso R-R in diretta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma leitura de HRV sentado durante 60 segundos na transmissão RR em direto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте 60-секундное измерение ВСР сидя по потоку R-R интервалов в реальном времени."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从实时 R-R 数据流中进行一次 60 秒的静坐 HRV 读数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從即時 R-R 資料流中進行一次 60 秒的靜坐 HRV 讀數。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykonaj 60-sekundowy odczyt HRV w pozycji siedzącej ze strumienia R-R na żywo."
          }
        }
      }
    },
