            "state": "translated",
            "value": "Ho capito"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Compreendo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Понятно"
          }
        },
        "zh-Hans": {
