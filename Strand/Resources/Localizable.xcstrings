    },
    "Nothing to reclaim right now. NOOP already cleans up import scratch space automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade nichts freizugeben. NOOP räumt den Import-Zwischenspeicher bereits automatisch auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que liberar ahora mismo. NOOP ya limpia automáticamente el espacio temporal de importación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à récupérer pour le moment. NOOP nettoie déjà automatiquement l'espace temporaire d'importation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente da recuperare al momento, NOOP ripulisce già automaticamente lo spazio temporaneo di importazione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada a recuperar agora. O NOOP já limpa o espaço de trabalho de importação automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас нечего освобождать. NOOP уже автоматически очищает временное место для импорта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前没有可回收的空间，NOOP 已自动清理导入的临时空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有可回收的空間，NOOP 已自動清理匯入的暫存空間。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tej chwili nie ma nic do odzyskania. NOOP już automatycznie czyści miejsce importu."
          }
        }
      }
    },
    "Nothing's flagging. Train to feel - your body's holding steady.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts schlägt Alarm. Trainiere nach Gefühl - dein Körper hält stabil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada está en alerta. Entrena según cómo te sientas: tu cuerpo se mantiene estable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne clignote. Entraînez-vous selon vos sensations - votre corps tient bon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente è in allerta. Allenati in base a come ti senti - il tuo corpo si mantiene stabile."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada está a sinalizar. Treine para sentir que o teu corpo está firme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не вызывает тревоги. Тренируйтесь по самочувствию — организм держится стабильно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有异常信号。按感觉训练——你的身体状态平稳。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有異常信號。按感覺訓練——你的身體狀態平穩。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie szwankuje. Trenuj, aby czuć – Twoje ciało trzyma się stabilnie."
          }
        }
      }
    },
