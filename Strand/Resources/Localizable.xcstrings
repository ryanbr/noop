    "below a good night, limiting recovery": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "unter einer guten Nacht, bremst die Erholung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "por debajo de una buena noche, limita la recuperación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "en dessous d'une bonne nuit, limite la récupération"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "sotto una buona notte, limita il recupero"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "abaixo de uma boa noite, limitando a recuperação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ниже хорошей ночи, ограничивает восстановление"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不及一夜好眠，限制恢复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不及一夜好眠，限制恢復"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "poniżej dobrej nocy, ograniczając powrót do zdrowia"
          }
        }
      }
    },
    "below baseline, limiting recovery": {
      "localizations": {
        "de": {
          "stringUnit": {
