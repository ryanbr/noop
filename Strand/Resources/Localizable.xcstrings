          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вклад этой тренировки в дневное Усилие, зафиксированный во время тренировки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次会话对当天消耗的贡献，即在锻炼期间所捕获的部分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次工作階段對當天消耗的貢獻，即在鍛鍊期間所擷取的部分。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udział tej sesji w dziennym Wysiłek zarejestrowany podczas treningu."
          }
        }
      }
    },
