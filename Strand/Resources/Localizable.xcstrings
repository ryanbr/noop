    "Charge %lld today, so your band is %lld–%lld bpm.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge heute %lld, daher liegt dein Zielbereich bei %lld–%lld bpm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge hoy %lld, así que tu zona es %lld–%lld ppm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge de %lld aujourd'hui, donc votre zone est de %lld–%lld bpm."
