          "stringUnit": {
            "state": "translated",
            "value": "休息：你的睡眠有多具修復性？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpoczynek: jak regenerujący był Twój sen?"
          }
        }
      }
    },
    "Restart": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neu starten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiniciar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarrer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riavvia"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiniciar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапустить"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
