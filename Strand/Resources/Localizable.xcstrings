    "Notifications are off, so this can't buzz yet. Turn on the master switch in Notifications to let it through.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind aus, das kann also noch nicht vibrieren. Schalte den Hauptschalter unter „Mitteilungen“ ein, um es durchzulassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas, así que esto aún no puede vibrar. Activa el interruptor principal en Notificaciones para permitirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées, donc cela ne peut pas encore vibrer. Activez l'interrupteur principal dans Notifications pour le laisser passer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate, quindi questo non può ancora vibrare, attiva l'interruttore principale in Notifiche per consentirlo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas, pelo que isto ainda não pode vibrar. Ligue a chave principal em Notificações para permitir a passagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления выключены, поэтому вибрация пока не сработает. Включите общий переключатель в разделе «Уведомления», чтобы разрешить её."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已关闭，因此这还无法震动，请在「通知」中打开总开关以放行它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已關閉，因此這還無法震動，請在「通知」中打開總開關以放行它。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są wyłączone, więc nie można jeszcze włączyć brzęczyka. Włącz wyłącznik główny w Powiadomieniach, aby go przepuścić."
          }
        }
      }
    },
