          }
        }
      }
    },
    "Your data has been restored. Quit and reopen NOOP for it to take effect.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten wurden wiederhergestellt. Beende NOOP und öffne es neu, damit es wirkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos se han restaurado. Cierra y vuelve a abrir NOOP para que surta efecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données ont été restaurées. Quittez puis rouvrez NOOP pour que cela prenne effet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati sono stati ripristinati. Esci e riapri NOOP perché abbiano effetto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus dados foram restaurados. Saia e reabra o NOOP para que tenha efeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши данные восстановлены. Закройте и снова откройте NOOP, чтобы изменения вступили в силу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的数据已恢复。退出并重新打开 NOOP 以使其生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
