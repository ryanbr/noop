    "Your signals are aligned and your load is supported. A harder session is well backed today.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Werte stimmen überein und deine Belastung ist gedeckt. Eine härtere Einheit ist heute gut abgesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus señales están alineadas y tu carga está respaldada. Hoy una sesión más dura está bien respaldada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos signaux sont alignés et votre charge est soutenue. Une séance plus intense est bien étayée aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi segnali sono allineati e il tuo carico è supportato. Una sessione più dura è ben sostenuta oggi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus sinais estão alinhados e a tua carga é suportada. Uma sessão mais difícil está bem apoiada hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши сигналы согласованы, и нагрузка поддержана. Сегодня более тяжёлая тренировка хорошо обоснована."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各项指标一致，你的负荷也有支撑。今天适合安排一次更高强度的训练。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "各項指標一致，你的負荷也有支撐。今天適合安排一次更高強度的訓練。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje sygnały są wyrównane, a obciążenie jest obsługiwane. Dzisiejsza trudniejsza sesja jest dobrze wspierana."
          }
        }
      }
    },
