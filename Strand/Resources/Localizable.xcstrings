          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse ficheiro não é um cópia de segurança NOOP. Não se parece com uma base de dados SQLite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл не является резервной копией NOOP. Он не похож на базу данных SQLite."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件不是 NOOP 备份，看起来不像 SQLite 数据库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該檔案不是 NOOP 備份，它看起來不像 SQLite 資料庫。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik nie jest kopią zapasową NOOP. To nie wygląda jak baza danych SQLite."
          }
        }
      }
    },
    "That is not a 32-character hex key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein 32-Zeichen-Hex-Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no es una clave hexadecimal de 32 caracteres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas une clé hexadécimale de 32 caractères."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella non è una chiave esadecimale di 32 caratteri."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta não é uma chave hexadecimal de 32 caracteres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не 32-символьный шестнадцатеричный ключ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那不是一个 32 字符的十六进制密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
