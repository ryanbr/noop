    "Needs the strap. No data for today. Was your strap worn and connected overnight?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht den Strap. Keine Daten für heute. War dein Strap über Nacht getragen und verbunden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita la pulsera. No hay datos de hoy. ¿Llevaste puesta y conectada tu pulsera durante la noche?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite le bracelet. Pas de données pour aujourd'hui. Votre bracelet était-il porté et connecté pendant la nuit ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede la fascia. Nessun dato per oggi. La tua fascia era indossata e connessa durante la notte?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa da pega. Não há dados para hoje. A tua bracelete foi usada e ligada durante a noite?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен браслет. Данных за сегодня нет. Был ли браслет надет и подключён ночью?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要手环。今天没有数据。昨晚手环有佩戴并保持连接吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要手環。今天沒有資料。昨晚你的手環有戴著並保持連接嗎？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebuje paska. Brak danych na dzisiaj. Czy pasek był noszony i podłączony przez noc?"
          }
        }
      }
    },
