        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está quase a dormir em %@. Os minutos dormidos são equilibrados com a tua necessidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В целом вы примерно соблюдаете норму сна за %@. Минуты сна уравновешивают вашу потребность."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在%@内你的睡眠大致跟上了节奏。实际睡眠时长与所需基本持平。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在%@內你的睡眠大致跟上了需求，睡眠分鐘數與所需相抵。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prawie nie śpisz przez %@. Minuty snu równoważą Twoje potrzeby."
          }
        }
      }
    },
    "You're sitting around your typical autonomic baseline: moderate stress, a normal, balanced day.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du liegst um deine typische autonome Basislinie: moderater Stress, ein normaler, ausgeglichener Tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás alrededor de tu línea base autonómica típica: estrés moderado, un día normal y equilibrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes autour de votre référence autonome typique : stress modéré, une journée normale et équilibrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei intorno alla tua tipica linea di base autonomica: stress moderato, una giornata normale ed equilibrata."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
