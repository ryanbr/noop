    "Step to another week with the arrows above to see its review.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle mit den Pfeilen oben zu einer anderen Woche, um ihren Rückblick zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa a otra semana con las flechas de arriba para ver su resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez à une autre semaine avec les flèches ci-dessus pour voir son bilan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa a un'altra settimana con le frecce sopra per vederne la rassegna."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
