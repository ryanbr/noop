            "value": "Carico cardiovascolare della giornata, su una scala 0–100 (prima 0–21)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga cardiovascular do dia, numa escala de 0 a 100 (era de 0 a 21)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сердечно-сосудистая нагрузка за день по шкале 0–100 (раньше 0–21)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当天的心血管负荷，按 0–100 计分（原为 0–21）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當天的心血管負荷，以 0–100 為量表（原為 0–21）。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obciążenie układu sercowo-naczyniowego w ciągu dnia w skali 0–100 (wynosiło 0–21)."
          }
        }
      }
    },
