    "Stay in a comfortable range; never force breath holds.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay in a comfortable range; never force breath holds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im angenehmen Bereich bleiben; Atemhalten nie erzwingen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quédate en un rango cómodo; nunca fuerces las retenções."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez dans une zone confortable ; ne forcez jamais les rétentions."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica numa faixa confortável; nunca forces retenções."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta in un range comodo; non forzare mai le trattenute."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostań w komfortowym zakresie; nigdy nie forsuj wstrzymań."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставайтесь в комфортном диапазоне; никогда не форсируйте задержки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持在舒适范围；切勿强行屏息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持在舒適範圍；切勿強行屏息。"
          }
        }
      }
    },
    "Estimate only — not medical advice. Stop if you feel unwell.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate only — not medical advice. Stop if you feel unwell."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Schätzung — keine medizinische Beratung. Bei Unwohlsein stoppen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo una estimación — no es consejo médico. Para si te encuentras mal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimation uniquement — pas un avis médical. Arrêtez si vous vous sentez mal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas uma estimativa — não é aconselhamento médico. Para se te sentires mal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo una stima — non è un consiglio medico. Fermati se ti senti male."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko szacunek — to nie porada medyczna. Przerwij, jeśli źle się czujesz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только оценка — не медицинский совет. Остановитесь, если плохо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅为估算——非医疗建议。如感不适请停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅為估算——非醫療建議。如感不適請停止。"
          }
        }
      }
    },
    "If you feel dizzy or uncomfortable, stop and breathe normally.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you feel dizzy or uncomfortable, stop and breathe normally."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Schwindel oder Unwohlsein stoppen und normal atmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si te mareas o te sientes mal, para y respira normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez le vertige ou un malaise, arrêtez et respirez normalement."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se te sentires tonto ou mal, para e respira normalmente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hai vertigini o disagio, fermati e respira normalmente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli kręci ci się w głowie lub jest źle, przerwij i oddychaj normalnie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При головокружении или дискомфорте остановитесь и дышите обычно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若头晕或不适，停止并正常呼吸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若頭暈或不適，停止並正常呼吸。"
          }
        }
      }
    },
    "Traditional sessions are long; use a short timer here as a check-in only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traditional sessions are long; use a short timer here as a check-in only."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
