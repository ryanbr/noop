    "Put the band into pairing mode, on your wrist and awake.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versetze das Band in den Kopplungsmodus, am Handgelenk und wach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon la banda en modo de emparejamiento, en tu muñeca y activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez la bande en mode d'appairage, à votre poignet et activée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti la band in modalità abbinamento, al polso e attiva."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque a bracelete no modo de emparelhamento, no pulso e acordada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переведите браслет в режим сопряжения, наденьте на запястье и убедитесь, что он активен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让手环进入配对模式，戴在手腕上并保持唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓手環進入配對模式，戴在你的手腕上並保持喚醒。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełącz opaskę w tryb parowania, załóż ją na nadgarstek i obudź się."
          }
        }
      }
    },
    "Put the strap on first. The deep stream is on-wrist only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg zuerst den Strap an. Der Deep-Stream läuft nur am Handgelenk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte la pulsera primero. La transmisión profunda solo funciona en la muñeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez d'abord le bracelet. Le flux profond fonctionne uniquement au poignet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indossa prima la fascia. Il flusso profondo funziona solo al polso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque a pega primeiro. O fluxo profundo ocorre apenas no pulso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала наденьте браслет. Глубокий поток данных доступен только при ношении на запястье."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先戴上手环。深度数据流仅在佩戴时可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先戴上手環，深度資料流僅在佩戴時可用。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw załóż pasek. Głęboki strumień jest dostępny tylko na nadgarstku."
          }
        }
      }
    },
    "Put your WHOOP 4.0 on your wrist and make sure it's awake.": {
