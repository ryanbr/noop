      }
    },
    "Warn me when I log caffeine too close to bedtime. A timing guide from your own bedtime, not a measurement.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warne mich, wenn ich Koffein zu nah an der Schlafenszeit erfasse. Ein Timing-Anhaltspunkt aus deiner eigenen Schlafenszeit, keine Messung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avísame cuando registre cafeína demasiado cerca de la hora de dormir. Una guía de horarios basada en tu propia hora de acostarte, no una medición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "M'avertir quand j'enregistre de la caféine trop proche du coucher. Un repère temporel basé sur votre propre heure de coucher, pas une mesure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisami quando registro la caffeina troppo vicino all'ora di dormire. Una guida sui tempi basata sul tuo orario di sonno, non una misurazione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Avise-me quando consumir cafeína muito perto da hora de dormir. Um guia de tempo da tua hora de dormir, não uma medida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предупреждать, если кофеин отмечен слишком близко ко сну. Ориентир по времени от вашего собственного отхода ко сну, а не измерение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当我在过于临近就寝时记录咖啡因时提醒我。这是基于你自己就寝时间的时间参考，而非测量值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當我在過於臨近就寢時記錄咖啡因時提醒我。這是基於你自己就寢時間的時間參考，而非測量值。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostrzegaj mnie, gdy zapiszę kofeinę zbyt blisko pory snu. Przewodnik czasowy na podstawie Twojej pory snu, a nie pomiaru."
          }
        }
      }
    },
