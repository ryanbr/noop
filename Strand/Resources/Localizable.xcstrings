    "On-device estimate (approximate), not a diagnosis.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schätzung auf dem Gerät (ungefähr), keine Diagnose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimación en el dispositivo (aproximada), no un diagnóstico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimation sur l'appareil (approximative), pas un diagnostic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stima sul dispositivo (approssimativa), non una diagnosi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimativa no dispositivo (aproximada), não um diagnóstico."
          }
        },
        "ru": {
          "stringUnit": {
