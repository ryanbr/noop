            "value": "Дважды нажмите на браслет, чтобы выполнить действие на %@. (Браслет поддерживает только один жест — двойное нажатие.)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击手环即可在 %@ 上触发一个操作。（手环只提供一个双击手势。）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點兩下手環，即可在 %@ 上觸發一個動作。（手環只提供單一的輕點兩下手勢。）"
          }
        },
        "pl": {
