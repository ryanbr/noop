            "state": "translated",
            "value": "正在測試 %@ 次/分鐘…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Testowanie %@ br/min…"
          }
        }
      }
    },
    "That file is too large to import.": {
