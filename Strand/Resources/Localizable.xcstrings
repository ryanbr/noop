    "And make sure it's charged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Und stelle sicher, dass er geladen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Y asegúrate de que esté cargada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Et assurez-vous qu'il est chargé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "E assicurati che sia carica."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "E certifique-se de que está carregado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И убедитесь, что он заряжен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "并确保它已充好电。"
          }
        },
        "zh-Hant": {
