          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dane zostały przywrócone. Zamknij i otwórz ponownie NOOP, aby zadziałało."
          }
        }
      }
    },
    "Your fluid intake today, on %@ only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Flüssigkeitsaufnahme heute, nur auf %@."
