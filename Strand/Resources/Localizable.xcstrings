            "value": "Что каждый браслет считывает вживую, а что требует импорта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每条设备可实时读取的内容，以及哪些需要导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每條裝置可即時讀取的內容，以及哪些需要匯入。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co każdy pasek może odczytać na żywo, a co wymaga importu."
          }
        }
      }
    },
    "ECG raw-data gate (WHOOP MG only)": {
      "localizations": {
