    "When %@ is higher, %@ tends to be higher.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn %1$@ höher ist, ist %2$@ tendenziell höher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "When %1$@ is higher, %2$@ tends to be higher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando %@ es más alto, %@ tiende a ser más alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand %1$@ est plus élevé, %2$@ tend à être plus élevé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando %@ è più alto, %@ tende a essere più alto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando %1$@ é maior, %2$@ tende a ser maior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда %1$@ выше, %2$@ обычно тоже выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当%@较高时，%@往往也较高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當%@較高時，%@往往也較高。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy %1$@ jest wyższe, %2$@ jest zwykle wyższe."
          }
        }
      }
    },
    "When %@ is higher, %@ tends to be lower.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn %1$@ höher ist, ist %2$@ tendenziell niedriger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "When %1$@ is higher, %2$@ tends to be lower."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando %@ es más alto, %@ tiende a ser más bajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand %1$@ est plus élevé, %2$@ tend à être plus bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando %@ è più alto, %@ tende a essere più basso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando %1$@ é maior, %2$@ tende a ser menor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда %1$@ выше, %2$@ обычно ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当%@较高时，%@往往较低。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當%@較高時，%@往往較低。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy %1$@ jest wyższe, %2$@ ma tendencję do bycia niższym."
          }
        }
      }
    },
    "When I double-tap": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ich doppelt tippe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When I double-tap"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando toco dos veces"
          }
        },
        "fr": {
          "stringUnit": {
