          "stringUnit": {
            "state": "translated",
            "value": "重新標註為"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz ponownie jako"
          }
        }
      }
    },
    "Re-nudge every": {
      "localizations": {
        "de": {
          "stringUnit": {
