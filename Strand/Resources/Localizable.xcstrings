      "zh-Hant": { "stringUnit": { "state": "translated", "value": "A mudança de temperatura ocorreu num momento diferente da data registada; o início indicado pode estar desfasado." } }
    } },
    "Your rhythm is hard to read right now. Keep wearing your device for a clearer picture.": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Dein Rhythmus ist gerade schwer zu erkennen. Trage dein Gerät weiter, damit das Bild klarer wird." } }, "en": { "stringUnit": { "state": "translated", "value": "Your rhythm is hard to read right now. Keep wearing your device for a clearer picture." } }, "es": { "stringUnit": { "state": "translated", "value": "Ahora mismo es difícil interpretar tu ritmo. Sigue llevando el dispositivo para obtener una imagen más clara." } }, "fr": { "stringUnit": { "state": "translated", "value": "Votre rythme est difficile à interpréter pour le moment. Continuez à porter votre appareil pour obtenir une image plus claire." } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "Neste momento, é difícil interpretar o teu ritmo. Continua a usar o dispositivo para obter uma imagem mais clara." } },
      "it": { "stringUnit": { "state": "translated", "value": "Neste momento, é difícil interpretar o teu ritmo. Continua a usar o dispositivo para obter uma imagem mais clara." } },
