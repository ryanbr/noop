    "Syncs your strap's stored history right away, instead of waiting for the next automatic sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiert den gespeicherten Verlauf deines Straps sofort, statt auf die nächste automatische Synchronisierung zu warten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza de inmediato el historial almacenado en tu pulsera, en vez de esperar a la próxima sincronización automática."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronise immédiatement l'historique stocké de votre bracelet, au lieu d'attendre la prochaine synchronisation automatique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizza subito la cronologia salvata sulla fascia, invece di aspettare la prossima sincronizzazione automatica."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza imediatamente o histórico armazenado da tua bracelete, em vez de esperar pela próxima sincronização automática."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизирует сохранённую историю браслета немедленно, не дожидаясь следующей автоматической синхронизации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即同步手环存储的历史数据，无需等待下次自动同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即同步手環中儲存的歷史資料，而不是等待下一次自動同步。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizuje zapisaną historię paska od razu, zamiast czekać na następną automatyczną synchronizację."
          }
        }
      }
    },
