    "Keep the ring on the charger or on your finger so it stays awake.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass den Ring auf dem Ladegerät oder am Finger, damit er wach bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el anillo en el cargador o en tu dedo para que permanezca despierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez l'anneau sur le chargeur ou à votre doigt pour qu'il reste éveillé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni l'anello sul caricatore o al dito, così resta sveglio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o anel no carregador ou no dedo para que fique acordado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите кольцо на зарядке или на пальце, чтобы оно оставалось активным."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把戒指放在充电器上或戴在手指上，让它保持唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請讓戒指留在充電器上或戴在手指上，讓它保持喚醒狀態。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzymaj pierścień na ładowarce lub na palcu, aby nie zasnął."
          }
        }
      }
    },
    "Keep your bloods, BP and body numbers private, on %@.": {
      "localizations": {
        "de": {
