    "Similar in spirit to WHOOP's Sleep Performance %; our composite is our own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ähnlich im Geist zu WHOOPs Sleep Performance %; unser Kompositwert ist unser eigener."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Similar en espíritu al % de rendimiento del sueño de WHOOP; nuestro compuesto es propio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparable dans l'esprit au % de performance du sommeil de WHOOP ; notre composite nous est propre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Simile nello spirito allo Sleep Performance % di WHOOP; il nostro composito è tutto nostro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
