    "Checks the project's home (GitHub) for the latest version when you tap. Nothing else is sent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft beim Tippen das Zuhause des Projekts (GitHub) auf die neueste Version. Sonst wird nichts gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta la página del proyecto (GitHub) para ver la última versión cuando tocas. No se envía nada más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie la page du projet (GitHub) pour la dernière version quand vous appuyez. Rien d'autre n'est envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando tocchi, verifica la pagina del progetto (GitHub) per l'ultima versione, non viene inviato nient'altro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica a página inicial do projeto (GitHub) para obter a versão mais recente quando toca. Nada mais é enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяет домашнюю страницу проекта (GitHub) на наличие последней версии при нажатии. Больше ничего не отправляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
