    "Offers to save a workout when it spots sustained elevated heart rate": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bietet an, ein Workout zu speichern, wenn anhaltend erhöhte Herzfrequenz erkannt wird"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ofrece guardar un entrenamiento cuando detecta frecuencia cardíaca elevada sostenida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Propose d'enregistrer un entraînement lorsqu'il détecte une fréquence cardiaque élevée soutenue"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Propone di salvare un allenamento quando rileva una frequenza cardiaca elevata e prolungata"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Oferece-se para guardar um treino quando deteta frequência cardíaca elevada sustentada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предлагает сохранить тренировку при устойчиво повышенном пульсе"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当它发现持续升高的心率时，会建议保存一次锻炼"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
