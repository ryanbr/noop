    "“Dose” here is timing (later in the day = stronger), not milligrams.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Dosis“ heißt hier Timing (später am Tag = stärker), nicht Milligramm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí la “dosis” es el horario (más tarde en el día = más fuerte), no los miligramos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ici, la « dose » est le moment (plus tard dans la journée = plus fort), pas les milligrammes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui la “dose” è il momento (più tardi nella giornata = più forte), non i milligrammi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“Dose” aqui é o tempo (mais tarde = mais forte), não miligramas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Доза» здесь — это время приёма (чем позже днём, тем сильнее эффект), а не миллиграммы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里的「剂量」指的是时间（越晚 = 越强），而非毫克数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡的「劑量」指的是時間（越晚 = 越強），而非毫克數。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Dawka” oznacza tutaj czas (później dnia = mocniejsza), a nie miligramy."
          }
        }
      }
    },
