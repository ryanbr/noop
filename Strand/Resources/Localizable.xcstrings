    "All of this is computed on your own device from data you already have. No heartbeat data leaves it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "All das wird auf deinem eigenen Gerät aus Daten berechnet, die du bereits hast. Keine Herzschlagdaten verlassen es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo esto se calcula en tu propio dispositivo a partir de datos que ya tienes. Ningún dato de latidos sale de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ceci est calculé sur votre propre appareil à partir de données que vous avez déjà. Aucune donnée de battement cardiaque n'en sort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto questo viene calcolato sul tuo dispositivo dai dati che hai già. Nessun dato del battito cardiaco lo lascia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo isto é computado no teu dispositivo a partir dos dados que já possui. Nenhum dado de batimento cardíaco sai dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё это рассчитывается на вашем устройстве на основе уже имеющихся данных. Данные о сердцебиении никуда не покидают устройство."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一切都是在你自己的设备上、用你已有的数据计算得出的。任何心跳数据都不会离开设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這一切都是在你自己的裝置上，用你已有的資料計算的。沒有任何心跳資料離開裝置。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko to jest obliczane na Twoim własnym urządzeniu na podstawie danych, które już posiadasz. Żadne dane o pulsie go nie opuszczają."
          }
        }
      }
    },
    "All stays on %@. Nothing is sent anywhere.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf %@. Nichts wird irgendwohin gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo permanece en %@. No se envía nada a ninguna parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur %@. Rien n'est envoyé nulle part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta su %@. Niente viene inviato da nessuna parte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo permanece em %@. Nada é enviado para lado nenhum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё остаётся на %@. Ничего никуда не отправляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都留在 %@ 上。不会发送到任何地方。"
