        }
      }
    },
    "Warn me about caffeine close to bedtime": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warne mich vor Koffein nahe der Schlafenszeit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avísame sobre la cafeína cerca de la hora de dormir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "M'avertir en cas de caféine proche du coucher"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisami sulla caffeina vicino all'ora di dormire"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Avise-me sobre a cafeína perto da hora de dormir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предупреждать о кофеине перед сном"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在临近就寝时提醒我注意咖啡因"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在臨近就寢時提醒我注意咖啡因"
          }
