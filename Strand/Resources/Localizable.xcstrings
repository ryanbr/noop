    "In your band. On track.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Zielbereich. Auf Kurs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu zona. Vas bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans votre zone. Sur la bonne voie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella tua fascia. Sei in linea."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tua banda. No bom caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В вашем диапазоне. Всё по плану."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处于目标区间内。状态良好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "處於目標區間內。狀態良好。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W twoim zespole. Na dobrej drodze."
          }
        }
      }
    },
    "In your data so far, this doesn’t move your %@ the way it typically does.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinen bisherigen Daten bewegt das dein %@ nicht so, wie es das typischerweise tut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tus datos hasta ahora, esto no mueve tu %@ como suele hacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans vos données jusqu'ici, cela ne fait pas évoluer votre %@ comme d'habitude."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nei tuoi dati finora, questo non influenza il tuo %@ come fa di solito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos teus dados até agora, isto não move o teu %@ como normalmente acontece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По вашим данным на сегодня, это не влияет на %@ так, как обычно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你目前的数据看，这并没有像通常那样影响你的%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到目前為止，在你的資料中，這對你 %@ 的影響不像通常那樣。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Twoich dotychczasowych danych nie powoduje to przeniesienia %@ w taki sposób, w jaki zwykle to robi."
          }
        }
      }
    },
