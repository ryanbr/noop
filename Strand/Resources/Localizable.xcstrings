    "A %@ tonight tends to line up with about %@ higher on tomorrow’s %@ for you, based on %lld of your %@ days.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ heute Nacht geht bei dir tendenziell mit etwa %2$@ mehr beim morgigen %3$@ einher, basierend auf %4$lld deiner %5$@ Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A %1$@ tonight tends to line up with about %2$@ higher on tomorrow’s %3$@ for you, based on %4$lld of your %5$@ days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un %@ esta noche tiende a coincidir con alrededor de %@ más en tu %@ de mañana, según %lld de tus %@ días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ce soir tend à s'accompagner d'environ %2$@ de plus sur votre %3$@ de demain, d'après %4$lld de vos %5$@ jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un %1$@ stanotte tende a corrispondere per te a circa %2$@ in più sul %3$@ di domani, sulla base di %4$lld dei tuoi %5$@ giorni."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um %1$@ desta noite tende a alinhar-se com cerca de %2$@ mais alto no %3$@ de amanhã para ti, com base em %4$lld dos teus %5$@ dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ сегодня ночью обычно связан с повышением %3$@ примерно на %2$@ на следующий день — по данным %4$lld из %5$@ ваших дней."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对你来说，今晚的%@往往对应高出约 %@ 的明日%@，依据是你 %lld 天（共 %@ 天）的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今晚的%@，往往對應著高出約 %@ 的明日%@，依據是你 %lld / %@ 天的資料。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiejszy wynik %1$@ zwykle pokrywa się z około %2$@ wyższym w przypadku jutrzejszego %3$@, w oparciu o %4$lld z Twoich dni %5$@."
          }
        }
      }
    },
