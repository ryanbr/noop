    "Use NOOP with just an Apple Watch. What it's great at, and where it's lighter than a strap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze NOOP nur mit einer Apple Watch. Worin sie großartig ist und wo sie leichter ist als ein Strap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa NOOP solo con un Apple Watch. En qué destaca y dónde es más limitado que una pulsera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez NOOP avec seulement une Apple Watch. Ce en quoi elle excelle, et où elle est plus légère qu'un bracelet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa NOOP solo con un Apple Watch. In cosa è eccellente, e dove è più debole rispetto a una fascia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilize o NOOP com apenas um Apple Watch. Em que é ótimo e em que é mais leve que uma bracelete."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте NOOP только с Apple Watch. В чём они хороши, а где уступают браслету."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用一块 Apple Watch 使用 NOOP。它擅长什么，以及在哪些方面比手环更薄弱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅用一塊 Apple Watch 使用 NOOP。它擅長什麼，以及在哪些方面比手環更薄弱。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj NOOP tylko z Apple Watch. W czym jest świetny, a w czym jest lżejszy od paska."
          }
        }
      }
    },
    "Use NOOP with your watch": {
      "localizations": {
        "de": {
