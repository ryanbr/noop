    "This permanently removes the on-device period-start history. Sensor history is not changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der auf diesem Gerät gespeicherte Verlauf der Periodenbeginne dauerhaft gelöscht. Der Sensorverlauf bleibt unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente el historial de inicios de período guardado en este dispositivo. El historial del sensor no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement l’historique des débuts de règles enregistré sur cet appareil. L’historique du capteur reste inchangé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione elimina definitivamente la cronologia delle date di inizio delle mestruazioni salvata sul dispositivo. La cronologia dei sensori non viene modificata."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto elimina permanentemente o histórico de inícios de período guardado neste dispositivo. O histórico dos sensores não é alterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это навсегда удалит сохранённую на устройстве историю дат начала менструации. История показаний датчиков не изменится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除保存在此设备上的经期开始日期历史。传感器历史不会更改。"
