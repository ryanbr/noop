    } },
    "Your body clock looks later, with a night-owl tendency.": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Deine innere Uhr scheint später zu laufen – mit einer Tendenz zum Nachtmenschen." } }, "en": { "stringUnit": { "state": "translated", "value": "Your body clock looks later, with a night-owl tendency." } }, "es": { "stringUnit": { "state": "translated", "value": "Tu reloj biológico parece más tardío, con tendencia nocturna." } }, "fr": { "stringUnit": { "state": "translated", "value": "Votre horloge biologique semble plus tardive, avec une tendance couche-tard." } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "O teu relógio biológico parece mais tardio, com tendência noturna." } },
      "it": { "stringUnit": { "state": "translated", "value": "O teu relógio biológico parece mais tardio, com tendência noturna." } },
      "pl": { "stringUnit": { "state": "translated", "value": "O teu relógio biológico parece mais tardio, com tendência noturna." } },
