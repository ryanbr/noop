            "state": "translated",
            "value": "Registra una sessione che hai monitorato altrove."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Registe uma sessão que tenha acompanhado noutro local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите сессию, отслеженную в другом месте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录一次你在别处追踪的会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄一次你在別處追蹤的工作階段。"
          }
        },
        "pl": {
          "stringUnit": {
