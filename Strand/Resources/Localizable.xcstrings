    "%@ No clear relationship. They move largely independently.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Kein klarer Zusammenhang. Sie bewegen sich weitgehend unabhängig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Sin relación clara. Se mueven de forma mayormente independiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Aucune relation claire. Elles évoluent en grande partie de façon indépendante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Nessuna relazione chiara. Si muovono in gran parte in modo indipendente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Sem relação clara. Movem-se em grande parte de forma independente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Чёткой связи нет. Показатели меняются в основном независимо друг от друга."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有明显关系。两者基本各自独立变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有明顯關聯。兩者大致各自獨立變化。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Brak jasnego związku. Poruszają się w dużej mierze niezależnie."
          }
        }
      }
    },
    "%@ When %@ rises, %@ tends to fall, a %@ %@ link.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Wenn %2$@ steigt, fällt %3$@ tendenziell (Zusammenhang: %4$@, %5$@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ When %2$@ rises, %3$@ tends to fall, a %4$@ %5$@ link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Cuando %@ sube, %@ tiende a bajar, un vínculo %@ %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Quand %2$@ augmente, %3$@ tend à diminuer, un lien %4$@ %5$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Quando %@ sale, %@ tende a scendere, un legame %@ %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Quando %2$@ sobe, %3$@ tende a descer, uma ligação %4$@ %5$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Когда %2$@ растёт, %3$@ обычно снижается — %4$@ %5$@ связь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 当 %@ 上升时，%@ 往往下降，属于 %@ %@ 关联。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 當 %@ 上升時，%@ 傾向下降，屬 %@ 的 %@ 關聯。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Kiedy %2$@ rośnie, %3$@ ma tendencję do spadania, łącze %4$@ %5$@."
          }
        }
      }
    },
    "%@ When %@ rises, %@ tends to rise, a %@ %@ link.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Wenn %2$@ steigt, steigt %3$@ tendenziell (Zusammenhang: %4$@, %5$@)."
