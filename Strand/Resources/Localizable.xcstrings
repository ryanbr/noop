      "zh-Hans": { "stringUnit": { "state": "translated", "value": "Ainda não existe um padrão de temperatura claro. Isto pode acontecer com ciclos irregulares, contraceção hormonal ou trabalho por turnos." } },
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "Ainda não existe um padrão de temperatura claro. Isto pode acontecer com ciclos irregulares, contraceção hormonal ou trabalho por turnos." } }
    } },
    "Learning your pattern from your nightly temperature. Keep wearing your device overnight.": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Dein Muster wird anhand deiner nächtlichen Temperatur gelernt. Trage dein Gerät weiter über Nacht." } }, "en": { "stringUnit": { "state": "translated", "value": "Learning your pattern from your nightly temperature. Keep wearing your device overnight." } }, "es": { "stringUnit": { "state": "translated", "value": "Estamos aprendiendo tu patrón a partir de la temperatura nocturna. Sigue llevando el dispositivo por la noche." } }, "fr": { "stringUnit": { "state": "translated", "value": "Votre profil est appris à partir de votre température nocturne. Continuez à porter votre appareil la nuit." } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "Estamos a aprender o teu padrão a partir da temperatura noturna. Continua a usar o dispositivo durante a noite." } },
      "it": { "stringUnit": { "state": "translated", "value": "Estamos a aprender o teu padrão a partir da temperatura noturna. Continua a usar o dispositivo durante a noite." } },
      "pl": { "stringUnit": { "state": "translated", "value": "Estamos a aprender o teu padrão a partir da temperatura noturna. Continua a usar o dispositivo durante a noite." } },
      "ru": { "stringUnit": { "state": "translated", "value": "Estamos a aprender o teu padrão a partir da temperatura noturna. Continua a usar o dispositivo durante a noite." } },
      "zh-Hans": { "stringUnit": { "state": "translated", "value": "Estamos a aprender o teu padrão a partir da temperatura noturna. Continua a usar o dispositivo durante a noite." } },
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "Estamos a aprender o teu padrão a partir da temperatura noturna. Continua a usar o dispositivo durante a noite." } }
    } },
    "Your temperature shift came at a different time than your logged date – the logged start may be off.": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Deine Temperaturveränderung trat zu einem anderen Zeitpunkt als das protokollierte Datum auf – der eingetragene Beginn könnte abweichen." } }, "en": { "stringUnit": { "state": "translated", "value": "Your temperature shift came at a different time than your logged date – the logged start may be off." } }, "es": { "stringUnit": { "state": "translated", "value": "El cambio de temperatura se produjo en otro momento distinto a la fecha registrada; puede que el inicio anotado no sea correcto." } }, "fr": { "stringUnit": { "state": "translated", "value": "Le changement de température est survenu à un autre moment que la date enregistrée ; le début indiqué est peut-être décalé." } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "A mudança de temperatura ocorreu num momento diferente da data registada; o início indicado pode estar desfasado." } },
      "it": { "stringUnit": { "state": "translated", "value": "A mudança de temperatura ocorreu num momento diferente da data registada; o início indicado pode estar desfasado." } },
      "pl": { "stringUnit": { "state": "translated", "value": "A mudança de temperatura ocorreu num momento diferente da data registada; o início indicado pode estar desfasado." } },
