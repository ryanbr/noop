    "Time in each %HRmax zone, derived from the strap's heart rate over this window (approximate).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit in jeder %HRmax-Zone, abgeleitet aus der Herzfrequenz des Straps über dieses Fenster (ungefähr)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo en cada zona de %HRmax, derivado de la frecuencia cardíaca de la pulsera en esta ventana (aproximado)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps dans chaque zone de %HRmax, dérivé de la fréquence cardiaque du bracelet sur cette fenêtre (approximatif)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo in ciascuna zona %HRmax, derivato dalla frequenza cardiaca della fascia in questo intervallo, approssimativo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo em cada zona %HRmax, derivado da frequência cardíaca da correia nesta janela (aproximado)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время в каждой зоне %HRmax, рассчитанное по пульсу браслета за этот период (приблизительно)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每个 %HRmax 区间的时间，根据此窗口内手环的心率推导得出，近似值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在每個 %HRmax 區間的時間，根據此視窗內手環的心率推導得出，近似值。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas w każdej strefie %HRmax, obliczony na podstawie tętna paska w tym oknie (w przybliżeniu)."
          }
        }
      }
    },
