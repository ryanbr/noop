          }
        }
      }
    },
    "Other sources don’t offload raw per-second data on-device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Quellen übertragen keine rohen Sekundendaten auf das Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otras fuentes no descargan datos en bruto por segundo en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres sources ne déchargent pas de données brutes par seconde sur l'appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altre sorgenti non scaricano dati grezzi al secondo sul dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outras fontes não descarregam dados brutos por segundo para o dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие источники не выгружают необработанные посекундные данные на устройство."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他来源不会在设备上卸载原始的逐秒数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他來源不會在裝置上卸載原始的逐秒資料。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne źródła nie przesyłają surowych danych na sekundę do urządzenia."
          }
        }
      }
    },
