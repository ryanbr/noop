    },
    "Picked as your main sleep because it started near your usual sleep time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Hauptschlaf gewählt, weil er nahe deiner üblichen Schlafenszeit begann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegido como tu sueño principal porque empezó cerca de tu hora habitual de dormir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisi comme votre sommeil principal car il a commencé près de votre heure de sommeil habituelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scelto come sonno principale perché è iniziato vicino al tuo solito orario di sonno."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhido como o teu sono principal porque começou perto do horário normal de sono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбран как основной сон, потому что начался примерно в ваше обычное время сна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被选为你的主睡眠，因为它的开始时间接近你通常的入睡时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "被選為你的主要睡眠，因為它的開始時間接近你通常的入睡時間。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany jako główny sen, ponieważ zaczynał się w pobliżu zwykłej pory snu."
          }
        }
      }
    },
    "Picked as your main sleep because it was your longest block (%@), near your usual bedtime.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Hauptschlaf gewählt, weil er dein längster Block war (%@), nahe deiner üblichen Schlafenszeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegido como tu sueño principal porque fue tu bloque más largo (%@), cerca de tu hora habitual de acostarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisi comme votre sommeil principal car c'était votre plus long bloc (%@), près de votre heure de coucher habituelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scelto come sonno principale perché era il tuo blocco più lungo (%@), vicino al tuo solito orario di riposo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhido como o teu sono principal porque foi o teu bloqueio mais longo (%@), perto da hora habitual de deitar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбран как основной сон, потому что это был самый длинный период (%@), близкий к вашему обычному времени отхода ко сну."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被选为你的主睡眠，因为它是你最长的睡眠段（%@），且接近你通常的就寝时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "被選為你的主要睡眠，因為它是你最長的睡眠區段（%@），且接近你通常的就寢時間。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany jako główny sen, ponieważ był to Twój najdłuższy blok (%@), zbliżający się do zwykłej pory snu."
          }
        }
      }
    },
