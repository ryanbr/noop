    "Wear it snug on your wrist or bicep, sensor against skin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag ihn eng am Handgelenk oder Bizeps, Sensor auf der Haut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llévala ajustada en la muñeca o el bíceps, con el sensor contra la piel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portez-le bien ajusté au poignet ou au biceps, capteur contre la peau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indossala aderente al polso o al bicipite, con il sensore a contatto con la pelle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa-o bem ajustado ao pulso ou aos bíceps, com o sensor encostado à pele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наденьте плотно на запястье или бицепс, датчиком к коже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把它贴合地戴在手腕或上臂，传感器紧贴皮肤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼合地戴在手腕或上臂，感測器緊貼皮膚。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noś go ściśle na nadgarstku lub bicepsie, tak aby czujnik przylegał do skóry."
          }
        }
      }
    },
