    "What moves you. Ranked patterns in your own data, and your dose-response.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was dich bewegt. Eingestufte Muster in deinen eigenen Daten und deine Dosis-Wirkung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que te mueve. Patrones clasificados en tus propios datos, y tu dosis-respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui vous fait bouger. Des tendances classées dans vos propres données, et votre relation dose-réponse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa ti muove. Schemi classificati nei tuoi dati e la tua risposta alla dose."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o move. Padrões classificados nos teus próprios dados e na tua dose-resposta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что вами движет. Ранжированные закономерности в ваших данных и ваша зависимость «доза-реакция»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么在影响你。你自己数据中已排名的规律，以及你的剂量反应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "什麼在影響你。你自己資料中已排名的規律，以及你的劑量反應。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co Cię porusza. Uszereguj wzorce na podstawie własnych danych i reakcji na dawkę."
          }
        }
      }
    },
