      "zh-Hans": { "stringUnit": { "state": "translated", "value": "Atrasa o teu relógio %@ h, cerca de uma hora por dia. Apenas luz e horários de sono." } },
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "Atrasa o teu relógio %@ h, cerca de uma hora por dia. Apenas luz e horários de sono." } }
    } },
    "No meaningful body-clock shift is needed. You are about aligned.": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Keine nennenswerte Verschiebung deiner inneren Uhr nötig. Du bist weitgehend im Rhythmus." } }, "en": { "stringUnit": { "state": "translated", "value": "No meaningful body-clock shift is needed. You are about aligned." } }, "es": { "stringUnit": { "state": "translated", "value": "No necesitas ajustar de forma significativa tu reloj biológico. Está prácticamente alineado." } }, "fr": { "stringUnit": { "state": "translated", "value": "Aucun décalage notable de votre horloge biologique n’est nécessaire. Vous êtes globalement aligné." } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "Não é necessário um ajuste significativo do teu relógio biológico. Está praticamente alinhado." } },
