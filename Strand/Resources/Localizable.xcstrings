        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 当 %@ 上升时，%@ 往往上升，属于 %@ %@ 关联。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
