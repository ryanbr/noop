    "Backup failed - re-pick the folder and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherung fehlgeschlagen – wähle den Ordner neu und versuch es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la copia. Vuelve a elegir la carpeta e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la sauvegarde. Choisissez à nouveau le dossier et réessayez."
