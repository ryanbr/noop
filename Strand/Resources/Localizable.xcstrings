    "Hard or late workout": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "hartes oder spätes Training" } }, "en": { "stringUnit": { "state": "translated", "value": "hard or late workout" } }, "es": { "stringUnit": { "state": "translated", "value": "entrenamiento intenso o tardío" } }, "fr": { "stringUnit": { "state": "translated", "value": "entraînement intense ou tardif" } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "treino intenso ou tardio" } },
      "it": { "stringUnit": { "state": "translated", "value": "treino intenso ou tardio" } },
