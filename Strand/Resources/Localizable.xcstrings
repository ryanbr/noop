    "Wrist alerts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handgelenk-Hinweise"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertas de muñeca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertes au poignet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisi al polso"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertas de pulso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления на запястье"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手腕提醒"
          }
        },
        "zh-Hant": {
