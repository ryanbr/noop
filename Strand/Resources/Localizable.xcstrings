        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Cuando %@ sube, %@ tiende a subir, un vínculo %@ %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Quand %2$@ augmente, %3$@ tend à augmenter, un lien %4$@ %5$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Quando %@ sale, %@ tende a salire, un legame %@ %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Quando %2$@ sobe, %3$@ tende a subir, uma ligação %4$@ %5$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Когда %2$@ растёт, %3$@ тоже обычно растёт — %4$@ %5$@ связь."
