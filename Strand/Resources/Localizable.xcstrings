    "Today's value is your recorded daily stress score (0–3).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der heutige Wert ist dein aufgezeichneter täglicher Stresswert (0–3)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's value is your recorded daily stress score (0–3)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor de hoy es tu puntuación diaria de estrés registrada (0–3)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur du jour est votre score de stress quotidien enregistré (0–3)."
