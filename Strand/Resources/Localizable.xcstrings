    "Strain nudges and your smart alarm tap your wrist the moment they fire.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belastungs-Anstöße und dein Smart-Wecker tippen dein Handgelenk an, sobald sie auslösen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avisos de esfuerzo y tu alarma inteligente tocan tu muñeca en el momento en que se activan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels d'effort et votre alarme intelligente tapotent votre poignet au moment où ils se déclenchent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi di Carico e la sveglia smart ti toccano il polso nel momento in cui scattano."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tensão e o teu alarme inteligente toca no teu pulso no momento em que disparam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсказки по Нагрузке и умный будильник вибрируют на запястье в момент срабатывания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强度提醒和智能闹钟触发时会立即轻叩你的手腕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "強度提示和你的智慧鬧鐘會在觸發的那一刻輕拍你的手腕。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szturchnięcia Obciążenie i inteligentny alarm stukają w Twój nadgarstek w momencie uruchomienia."
          }
        }
      }
    },
