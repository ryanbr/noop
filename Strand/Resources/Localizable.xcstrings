          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你正处于典型的自主神经基线附近：压力适中，是正常、平衡的一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
