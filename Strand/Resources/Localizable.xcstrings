    "Follicular range – temperature is near your baseline.": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Follikuläre Phase – die Temperatur liegt nahe deinem Ausgangswert." } }, "en": { "stringUnit": { "state": "translated", "value": "Follicular range – temperature is near your baseline." } }, "es": { "stringUnit": { "state": "translated", "value": "Fase folicular: la temperatura está cerca de tu valor de referencia." } }, "fr": { "stringUnit": { "state": "translated", "value": "Phase folliculaire : la température est proche de votre valeur de référence." } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "Fase folicular: a temperatura está próxima do teu valor de referência." } },
