    "Stop caffeine after about %@ to keep most of it cleared by %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hör etwa ab %1$@ mit Koffein auf, damit das meiste bis %2$@ abgebaut ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Stop caffeine after about %1$@ to keep most of it cleared by %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja la cafeína después de aproximadamente las %@ para tener la mayor parte eliminada hacia las %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez la caféine vers %1$@ pour en avoir éliminé la majeure partie d'ici %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smetti con la caffeina dopo circa %1$@ per smaltirne gran parte entro %2$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare a cafeína após cerca de %1$@ para manter a maior parte eliminada até %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прекратите употреблять кофеин примерно за %1$@, чтобы большая часть вывелась к %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在大约 %1$@ 之后停止摄入咖啡因，以便在 %2$@ 前将其大部分代谢掉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在大約 %1$@ 之後停止攝入咖啡因，以便在 %2$@ 前將其大部分代謝掉。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj kofeinę po około %1$@, aby większość została usunięta przez %2$@."
          }
        }
      }
    },
