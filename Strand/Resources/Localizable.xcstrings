    "Last night, %@. Tonight's lands after you sleep with the strap on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte Nacht, %@. Der Wert für heute Nacht kommt, nachdem du mit dem Strap geschlafen hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anoche, %@. La de esta noche llegará después de que duermas con la pulsera puesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nuit dernière, %@. Celui de ce soir arrivera après que vous aurez dormi avec le bracelet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scorsa notte, %@. Quello di stanotte arriva dopo che avrai dormito con la fascia indosso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontem à noite, %@. A noite de hoje chega depois de ter dormido com a pega."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прошлой ночью, %@. Данные за сегодняшнюю ночь появятся после того, как вы поспите с браслетом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昨晚，%@。今晚的分数会在你戴着手环睡觉后出来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "昨晚，%@。今晚的分數會在你戴著手環入睡後出現。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeszłej nocy %@. Dzisiejsza noc kończy się po tym, jak śpisz z założonym paskiem."
          }
        }
      }
    },
