            "value": "Scansiona di nuovo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitalizar novamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканировать заново"
          }
        },
        "zh-Hans": {
          "stringUnit": {
