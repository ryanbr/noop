    } },
    "Skin temperature +%@ °C": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Hauttemperatur +%@ °C" } }, "en": { "stringUnit": { "state": "translated", "value": "Skin temperature +%@ °C" } }, "es": { "stringUnit": { "state": "translated", "value": "Temperatura de la piel +%@ °C" } }, "fr": { "stringUnit": { "state": "translated", "value": "Température cutanée +%@ °C" } }, "it": { "stringUnit": { "state": "translated", "value": "Temperatura cutanea +%@ °C" } }, "pl": { "stringUnit": { "state": "translated", "value": "Temperatura skóry +%@ °C" } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "Temperatura da pele +%@ °C" } }, "ru": { "stringUnit": { "state": "translated", "value": "Температура кожи +%@ °C" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "皮肤温度 +%@ °C" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "皮膚溫度 +%@ °C" } }
    } },
    "Respiration up": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Atemfrequenz erhöht" } }, "en": { "stringUnit": { "state": "translated", "value": "Respiration up" } }, "es": { "stringUnit": { "state": "translated", "value": "Respiración elevada" } }, "fr": { "stringUnit": { "state": "translated", "value": "Respiration élevée" } }, "it": { "stringUnit": { "state": "translated", "value": "Respirazione elevata" } }, "pl": { "stringUnit": { "state": "translated", "value": "Oddech podwyższony" } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "Respiração elevada" } }, "ru": { "stringUnit": { "state": "translated", "value": "Частота дыхания повышена" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "呼吸频率升高" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "呼吸頻率升高" } }
    } },
    "%@ vs %@ %@": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "%1$@ vs. %2$@ %3$@" } }, "en": { "stringUnit": { "state": "translated", "value": "%@ vs %@ %@" } }, "es": { "stringUnit": { "state": "translated", "value": "%1$@ frente a %2$@ %3$@" } }, "fr": { "stringUnit": { "state": "translated", "value": "%1$@ contre %2$@ %3$@" } }, "it": { "stringUnit": { "state": "translated", "value": "%1$@ rispetto a %2$@ %3$@" } }, "pl": { "stringUnit": { "state": "translated", "value": "%1$@ vs %2$@ %3$@" } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "%1$@ vs. %2$@ %3$@" } }, "ru": { "stringUnit": { "state": "translated", "value": "%1$@ против %2$@ %3$@" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "%1$@ 对比 %2$@ %3$@" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "%1$@ 對比 %2$@ %3$@" } }
    } },
    "7d %@ / 28d %@": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "7 T %@ / 28 T %@" } }, "en": { "stringUnit": { "state": "translated", "value": "7d %@ / 28d %@" } }, "es": { "stringUnit": { "state": "translated", "value": "7 d %@ / 28 d %@" } }, "fr": { "stringUnit": { "state": "translated", "value": "7 j %@ / 28 j %@" } }, "it": { "stringUnit": { "state": "translated", "value": "7 g %@ / 28 g %@" } }, "pl": { "stringUnit": { "state": "translated", "value": "7 d %@ / 28 d %@" } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "7 d %@ / 28 d %@" } }, "ru": { "stringUnit": { "state": "translated", "value": "7 д %@ / 28 д %@" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "7 天 %@ / 28 天 %@" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "7 天 %@ / 28 天 %@" } }
    } },
    "monotony %@": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Monotonie %@" } }, "en": { "stringUnit": { "state": "translated", "value": "monotony %@" } }, "es": { "stringUnit": { "state": "translated", "value": "monotonía %@" } }, "fr": { "stringUnit": { "state": "translated", "value": "monotonie %@" } }, "it": { "stringUnit": { "state": "translated", "value": "monotonia %@" } }, "pl": { "stringUnit": { "state": "translated", "value": "monotonia %@" } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "monotonia %@" } }, "ru": { "stringUnit": { "state": "translated", "value": "монотонность %@" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "单调度 %@" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "單調度 %@" } }
    } },
    "Your body looks strained. Signals up: %@. No alcohol or travel was logged, so consider taking it easy. On-device estimate, not a diagnosis.": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Dein Körper wirkt belastet. Auffällige Signale: %@. Da weder Alkohol noch Reisen protokolliert wurden, solltest du es ruhiger angehen. Schätzung auf dem Gerät, keine Diagnose." } }, "en": { "stringUnit": { "state": "translated", "value": "Your body looks strained. Signals up: %@. No alcohol or travel was logged, so consider taking it easy. On-device estimate, not a diagnosis." } }, "es": { "stringUnit": { "state": "translated", "value": "Tu cuerpo parece estar bajo presión. Señales elevadas: %@. Como no has registrado alcohol ni viajes, plantéate tomártelo con calma. Estimación en el dispositivo, no es un diagnóstico." } }, "fr": { "stringUnit": { "state": "translated", "value": "Votre corps semble éprouvé. Signaux élevés : %@. Comme aucun alcool ni voyage n’a été enregistré, envisagez de lever le pied. Estimation sur l’appareil, pas un diagnostic." } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "O teu corpo parece sob esforço. Sinais elevados: %@. Como não registaste álcool nem viagens, considera abrandar. Estimativa no dispositivo, não é um diagnóstico." } },
      "it": { "stringUnit": { "state": "translated", "value": "Il tuo corpo sembra sotto sforzo. Segnali elevati: %@. Non risultano alcol o viaggi registrati, quindi considera di prendertela con calma. Stima sul dispositivo, non è una diagnosi." } },
      "pl": { "stringUnit": { "state": "translated", "value": "Twój organizm wygląda na przeciążony. Podwyższone sygnały: %@. Nie zarejestrowano alkoholu ani podróży, więc rozważ spokojniejszy dzień. Ocena na urządzeniu, nie diagnoza." } },
      "ru": { "stringUnit": { "state": "translated", "value": "Похоже, организм испытывает нагрузку. Повышенные показатели: %@. Алкоголь и поездки не отмечены, поэтому постарайтесь снизить нагрузку. Оценка на устройстве, не диагноз." } },
      "zh-Hans": { "stringUnit": { "state": "translated", "value": "你的身体似乎承受着较大压力。升高的信号：%@。未记录饮酒或旅行，因此请考虑放松一些。设备端估算，不是诊断。" } },
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "你的身體似乎承受著較大壓力。升高的訊號：%@。未記錄飲酒或旅行，因此請考慮放鬆一些。裝置端估算，不是診斷。" } }
    } },
    "You logged feeling unwell, and your signals agree. Take it easy today. On-device estimate, not a diagnosis.": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Du hast angegeben, dass du dich unwohl fühlst, und deine Signale passen dazu. Geh es heute ruhig an. Schätzung auf dem Gerät, keine Diagnose." } }, "en": { "stringUnit": { "state": "translated", "value": "You logged feeling unwell, and your signals agree. Take it easy today. On-device estimate, not a diagnosis." } }, "es": { "stringUnit": { "state": "translated", "value": "Has registrado que no te encuentras bien y tus señales coinciden. Tómatelo con calma hoy. Estimación en el dispositivo, no es un diagnóstico." } }, "fr": { "stringUnit": { "state": "translated", "value": "Vous avez indiqué ne pas vous sentir bien et vos signaux concordent. Levez le pied aujourd’hui. Estimation sur l’appareil, pas un diagnostic." } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "Registaste que não te sentes bem e os teus sinais estão de acordo. Tem calma hoje. Estimativa no dispositivo, não é um diagnóstico." } },
      "it": { "stringUnit": { "state": "translated", "value": "Hai registrato di non sentirti bene e i tuoi segnali lo confermano. Riposati oggi. Stima sul dispositivo, non è una diagnosi." } },
      "pl": { "stringUnit": { "state": "translated", "value": "Zarejestrowano złe samopoczucie, a sygnały organizmu to potwierdzają. Dziś zwolnij tempo. Ocena na urządzeniu, nie diagnoza." } },
      "ru": { "stringUnit": { "state": "translated", "value": "Вы отметили плохое самочувствие, и показатели это подтверждают. Сегодня снизьте нагрузку. Оценка на устройстве, не диагноз." } },
      "zh-Hans": { "stringUnit": { "state": "translated", "value": "你记录了身体不适，相关信号也与之吻合。今天请放松休息。设备端估算，不是诊断。" } },
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "你記錄了身體不適，相關訊號也與之吻合。今天請放鬆休息。裝置端估算，不是診斷。" } }
    } },
    "You logged feeling unwell. Take it easy today. On-device estimate, not a diagnosis.": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Du hast angegeben, dass du dich unwohl fühlst. Geh es heute ruhig an. Schätzung auf dem Gerät, keine Diagnose." } }, "en": { "stringUnit": { "state": "translated", "value": "You logged feeling unwell. Take it easy today. On-device estimate, not a diagnosis." } }, "es": { "stringUnit": { "state": "translated", "value": "Has registrado que no te encuentras bien. Tómatelo con calma hoy. Estimación en el dispositivo, no es un diagnóstico." } }, "fr": { "stringUnit": { "state": "translated", "value": "Vous avez indiqué ne pas vous sentir bien. Levez le pied aujourd’hui. Estimation sur l’appareil, pas un diagnostic." } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "Registaste que não te sentes bem. Tem calma hoje. Estimativa no dispositivo, não é um diagnóstico." } },
      "it": { "stringUnit": { "state": "translated", "value": "Hai registrato di non sentirti bene. Riposati oggi. Stima sul dispositivo, non è una diagnosi." } },
      "pl": { "stringUnit": { "state": "translated", "value": "Zarejestrowano złe samopoczucie. Dziś zwolnij tempo. Ocena na urządzeniu, nie diagnoza." } },
      "ru": { "stringUnit": { "state": "translated", "value": "Вы отметили плохое самочувствие. Сегодня снизьте нагрузку. Оценка на устройстве, не диагноз." } },
      "zh-Hans": { "stringUnit": { "state": "translated", "value": "你记录了身体不适。今天请放松休息。设备端估算，不是诊断。" } },
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "你記錄了身體不適。今天請放鬆休息。裝置端估算，不是診斷。" } }
    } },
    "Some signals are up, but you logged %@. That is the more likely explanation. On-device estimate, not a diagnosis.": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Einige Signale sind erhöht, aber du hast %@ protokolliert. Das ist die wahrscheinlichere Erklärung. Schätzung auf dem Gerät, keine Diagnose." } }, "en": { "stringUnit": { "state": "translated", "value": "Some signals are up, but you logged %@. That is the more likely explanation. On-device estimate, not a diagnosis." } }, "es": { "stringUnit": { "state": "translated", "value": "Algunas señales están elevadas, pero has registrado %@. Esa es la explicación más probable. Estimación en el dispositivo, no es un diagnóstico." } }, "fr": { "stringUnit": { "state": "translated", "value": "Certains signaux sont élevés, mais vous avez enregistré %@. C’est l’explication la plus probable. Estimation sur l’appareil, pas un diagnostic." } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "Alguns sinais estão elevados, mas registaste %@. Essa é a explicação mais provável. Estimativa no dispositivo, não é um diagnóstico." } },
      "it": { "stringUnit": { "state": "translated", "value": "Alcuni segnali sono elevati, ma hai registrato %@. Questa è la spiegazione più probabile. Stima sul dispositivo, non è una diagnosi." } },
      "pl": { "stringUnit": { "state": "translated", "value": "Niektóre sygnały są podwyższone, ale zarejestrowano %@. To najbardziej prawdopodobne wyjaśnienie. Ocena na urządzeniu, nie diagnoza." } },
      "ru": { "stringUnit": { "state": "translated", "value": "Некоторые показатели повышены, но отмечено: %@. Скорее всего, причина именно в этом. Оценка на устройстве, не диагноз." } },
      "zh-Hans": { "stringUnit": { "state": "translated", "value": "部分信号升高，但你记录了%@。这更可能是原因。设备端估算，不是诊断。" } },
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "部分訊號升高，但你記錄了%@。這更可能是原因。裝置端估算，不是診斷。" } }
    } },
    "A few signals are mildly up: %@. Nothing alarming, but a calmer day may help. On-device estimate, not a diagnosis.": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Einige Signale sind leicht erhöht: %@. Kein Grund zur Sorge, aber ein ruhigerer Tag könnte helfen. Schätzung auf dem Gerät, keine Diagnose." } }, "en": { "stringUnit": { "state": "translated", "value": "A few signals are mildly up: %@. Nothing alarming, but a calmer day may help. On-device estimate, not a diagnosis." } }, "es": { "stringUnit": { "state": "translated", "value": "Algunas señales están ligeramente elevadas: %@. No es alarmante, pero un día más tranquilo podría ayudar. Estimación en el dispositivo, no es un diagnóstico." } }, "fr": { "stringUnit": { "state": "translated", "value": "Quelques signaux sont légèrement élevés : %@. Rien d’alarmant, mais une journée plus calme peut aider. Estimation sur l’appareil, pas un diagnostic." } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "Alguns sinais estão ligeiramente elevados: %@. Não é alarmante, mas um dia mais calmo pode ajudar. Estimativa no dispositivo, não é um diagnóstico." } },
      "it": { "stringUnit": { "state": "translated", "value": "Alcuni segnali sono leggermente elevati: %@. Nulla di allarmante, ma una giornata più tranquilla può aiutare. Stima sul dispositivo, non è una diagnosi." } },
      "pl": { "stringUnit": { "state": "translated", "value": "Kilka sygnałów jest lekko podwyższonych: %@. Nie ma powodów do niepokoju, ale spokojniejszy dzień może pomóc. Ocena na urządzeniu, nie diagnoza." } },
      "ru": { "stringUnit": { "state": "translated", "value": "Несколько показателей немного повышены: %@. Ничего тревожного, но более спокойный день может помочь. Оценка на устройстве, не диагноз." } },
      "zh-Hans": { "stringUnit": { "state": "translated", "value": "有几个信号略有升高：%@。无需担心，但轻松度过一天可能会有帮助。设备端估算，不是诊断。" } },
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "有幾個訊號略有升高：%@。無需擔心，但輕鬆度過一天可能會有幫助。裝置端估算，不是診斷。" } }
    } },
    "Still learning your baseline and keeping an eye on your signals.": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Dein Ausgangswert wird noch gelernt und deine Signale werden weiter beobachtet." } }, "en": { "stringUnit": { "state": "translated", "value": "Still learning your baseline and keeping an eye on your signals." } }, "es": { "stringUnit": { "state": "translated", "value": "Todavía estamos aprendiendo tu valor de referencia y observando tus señales." } }, "fr": { "stringUnit": { "state": "translated", "value": "Votre valeur de référence est encore en cours d’apprentissage et vos signaux restent sous surveillance." } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "Ainda estamos a aprender o teu valor de referência e a acompanhar os teus sinais." } },
      "it": { "stringUnit": { "state": "translated", "value": "Stiamo ancora imparando i tuoi valori di riferimento e tenendo d’occhio i tuoi segnali." } },
      "pl": { "stringUnit": { "state": "translated", "value": "Nadal uczymy się Twoich wartości bazowych i obserwujemy sygnały organizmu." } },
      "ru": { "stringUnit": { "state": "translated", "value": "Мы всё ещё изучаем ваши базовые значения и следим за показателями." } },
      "zh-Hans": { "stringUnit": { "state": "translated", "value": "仍在了解你的基线并持续关注相关信号。" } },
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "仍在瞭解你的基線並持續關注相關訊號。" } }
    } },
    "Nothing notable. Your signals look like their normal range.": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Nichts Auffälliges. Deine Signale liegen im normalen Bereich." } }, "en": { "stringUnit": { "state": "translated", "value": "Nothing notable. Your signals look like their normal range." } }, "es": { "stringUnit": { "state": "translated", "value": "Nada destacable. Tus señales parecen estar dentro de su rango normal." } }, "fr": { "stringUnit": { "state": "translated", "value": "Rien de notable. Vos signaux semblent dans leur plage habituelle." } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "Nada de relevante. Os teus sinais parecem estar dentro do intervalo normal." } },
      "it": { "stringUnit": { "state": "translated", "value": "Nulla di rilevante. I tuoi segnali sembrano rientrare nell’intervallo normale." } },
      "pl": { "stringUnit": { "state": "translated", "value": "Nic szczególnego. Sygnały organizmu mieszczą się w typowym zakresie." } },
      "ru": { "stringUnit": { "state": "translated", "value": "Ничего необычного. Показатели находятся в обычном диапазоне." } },
      "zh-Hans": { "stringUnit": { "state": "translated", "value": "没有明显异常。你的信号处于正常范围内。" } },
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "沒有明顯異常。你的訊號處於正常範圍內。" } }
    } },
