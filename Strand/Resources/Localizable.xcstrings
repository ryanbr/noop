    } },
    "No clear temperature pattern yet. This can happen with irregular cycles, hormonal contraception or shift work.": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Noch kein klares Temperaturmuster. Das kann bei unregelmäßigen Zyklen, hormoneller Verhütung oder Schichtarbeit vorkommen." } }, "en": { "stringUnit": { "state": "translated", "value": "No clear temperature pattern yet. This can happen with irregular cycles, hormonal contraception or shift work." } }, "es": { "stringUnit": { "state": "translated", "value": "Aún no hay un patrón de temperatura claro. Puede ocurrir con ciclos irregulares, anticoncepción hormonal o trabajo por turnos." } }, "fr": { "stringUnit": { "state": "translated", "value": "Aucun profil de température clair pour le moment. Cela peut arriver avec des cycles irréguliers, une contraception hormonale ou le travail posté." } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "Ainda não existe um padrão de temperatura claro. Isto pode acontecer com ciclos irregulares, contraceção hormonal ou trabalho por turnos." } },
