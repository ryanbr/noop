    "Powers Effort now; Charge and Rest once enough nights and decode are confirmed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speist jetzt Belastung; Energie und Erholung, sobald genug Nächte und die Dekodierung bestätigt sind"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimenta Esfuerzo ahora; Carga y Descanso cuando se confirmen suficientes noches y la decodificación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimente l'Effort dès maintenant ; Charge et Repos une fois que suffisamment de nuits et le décodage sont confirmés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimenta subito Sforzo; Carica e Riposo una volta confermate abbastanza notti e la decodifica"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esforço de poderes agora; Carregue e descanse assim que as noites suficientes e a descodificação forem confirmadas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас обеспечивает данными Усилие; Заряд и Отдых — как только накопится достаточно ночей и подтвердится декодирование"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在驱动消耗；待累积足够的夜晚并确认解码后，将驱动能量和休息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前為消耗提供資料；累積足夠夜晚並確認解碼後，也會支援能量和休息"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsługuje teraz Wysiłek; Energia i Odpoczynek po potwierdzeniu wystarczającej liczby nocy i dekodowania"
          }
        }
      }
    },
    "Powers Rest, Effort, Fitness Age and steps, plus Charge once recovery calibrates": {
      "localizations": {
        "de": {
