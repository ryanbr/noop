        }
      }
    },
    "Always rely on your doctor, pharmacist, or a qualified professional to interpret results and make decisions. If a number worries you, talk to them, not to an app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlass dich bei der Interpretation von Ergebnissen und bei Entscheidungen immer auf Arzt, Apotheke oder qualifiziertes Fachpersonal. Wenn dich eine Zahl beunruhigt, sprich mit ihnen, nicht mit einer App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confía siempre en tu médico, farmacéutico o un profesional cualificado para interpretar resultados y tomar decisiones. Si un número te preocupa, habla con ellos, no con una app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiez-vous toujours à votre médecin, pharmacien ou un professionnel qualifié pour interpréter les résultats et prendre des décisions. Si un chiffre vous inquiète, parlez-en à eux, pas à une application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Affidati sempre al tuo medico, al farmacista o a un professionista qualificato per interpretare i risultati e prendere decisioni. Se un numero ti preoccupa, parlane con loro, non con un'app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte sempre com o teu médico, farmacêutico ou profissional qualificado para interpretar os resultados e tomar decisões. Se um número o preocupa, fale com ele, e não com uma aplicação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда полагайтесь на врача, фармацевта или квалифицированного специалиста для интерпретации результатов и принятия решений. Если число вас беспокоит, обратитесь к ним, а не к приложению."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解读结果和做决定时，请始终依靠你的医生、药剂师或专业人士。如果某个数字让你担心，去找他们，而不是找一个应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解讀結果和做決定時，請永遠仰賴你的醫師、藥師或合格的專業人員。如果某個數字讓你擔心，去找他們談，而不是找一個應用程式。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze polegaj na swoim lekarzu, farmaceucie lub wykwalifikowanym specjalistie w zakresie interpretacji wyników i podejmowania decyzji. Jeśli jakiś numer Cię niepokoi, porozmawiaj z nim, a nie z aplikacją."
          }
        }
      }
    },
