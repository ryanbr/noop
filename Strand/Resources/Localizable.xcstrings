    "Luteal range – temperature is above your baseline.": { "localizations": {
      "de": { "stringUnit": { "state": "translated", "value": "Luteale Phase – die Temperatur liegt über deinem Ausgangswert." } }, "en": { "stringUnit": { "state": "translated", "value": "Luteal range – temperature is above your baseline." } }, "es": { "stringUnit": { "state": "translated", "value": "Fase lútea: la temperatura está por encima de tu valor de referencia." } }, "fr": { "stringUnit": { "state": "translated", "value": "Phase lutéale : la température est supérieure à votre valeur de référence." } }, "pt-PT": { "stringUnit": { "state": "translated", "value": "Fase lútea: a temperatura está acima do teu valor de referência." } },
