    "%@. Swipe or tap to change day": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Zum Tageswechsel streichen oder tippen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Desliza o toca para cambiar de día"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Balayez ou touchez pour changer de jour"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Scorri o tocca per cambiare giorno"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Deslize ou toque para alterar o dia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Проведите пальцем или нажмите, чтобы сменить день"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。滑动或点击以切换日期"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。滑動或點擊以切換日期"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Przesuń lub dotknij, aby zmienić dzień"
          }
        }
      }
    },
    "%@. Tap to pick a day, swipe to change day.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Tippe, um einen Tag auszuwählen, wische, um den Tag zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Toca para elegir un día, desliza para cambiar de día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Touchez pour choisir un jour, balayez pour changer de jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Tocca per scegliere un giorno, scorri per cambiare giorno."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Toque para escolher um dia, deslize para alterar o dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Нажмите, чтобы выбрать день, или проведите пальцем, чтобы сменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。点按以选择日期，滑动以切换日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。點按以選擇日期，滑動以切換日期。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Stuknij, aby wybrać dzień, przesuń, aby zmienić dzień."
          }
        }
      }
    },
