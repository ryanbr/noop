    "Low refresh": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seltener aktualisieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualización lenta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rafraîchissement réduit"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualização reduzida"
          }
        },
