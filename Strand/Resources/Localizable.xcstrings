        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe um treino manualmente. Regista a frequência cardíaca e o esforço até o terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте тренировку вручную. Фиксирует пульс и усилие, пока вы её не завершите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动追踪一次锻炼，记录心率和消耗，直到你结束它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手動追蹤一次鍛鍊，記錄心率和消耗，直到你結束它。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź trening ręcznie. Rejestruje tętno i wysiłek, dopóki go nie zakończysz."
          }
        }
      }
    },
