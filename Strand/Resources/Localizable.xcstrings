    "Drag to reorder. Move an item to Hidden to remove it from Today without deleting it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Neuanordnen ziehen. Verschiebe ein Element nach „Ausgeblendet“, um es von „Heute“ zu entfernen, ohne es zu löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Mueve un elemento a Ocultos para quitarlo de Hoy sin eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réorganiser. Déplacez un élément dans Masqués pour le retirer d’Aujourd’hui sans le supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Sposta un elemento in Nascosti per rimuoverlo da Oggi senza eliminarlo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta para reordenar. Move um item para Ocultos para o remover de Hoje sem o apagar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте элементы, чтобы изменить порядок. Переместите элемент в раздел «Скрыто», чтобы убрать его из «Сегодня», не удаляя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以重新排序。将项目移至“已隐藏”可从“今天”中移除，但不会删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以重新排序。將項目移至「已隱藏」可從「今天」中移除，但不會刪除。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby zmienić kolejność. Przenieś element do Ukrytego, aby usunąć go z Dzisiaj bez usuwania."
          }
        }
      }
    },
    "Drag to reorder. Toggle a card on or off. Cards with no value yet show a dash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen zum Neuordnen. Karten ein- oder ausschalten. Karten ohne Wert zeigen einen Strich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Activa o desactiva una tarjeta. Las tarjetas sin valor todavía muestran un guion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réorganiser. Activez ou désactivez une carte. Les cartes sans valeur affichent encore un tiret."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Attiva o disattiva una scheda. Le schede senza valore mostrano un trattino."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. Ative ou desative um cartão. Os cartões sem valor ainda mostram um vestígio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы изменить порядок. Включайте и выключайте карточки. Карточки, для которых пока нет значения, показывают тире."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以重新排序。开启或关闭某张卡片。尚无数值的卡片会显示一个短横。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動以重新排序。開啟或關閉某張卡片。尚無數值的卡片會顯示一個短橫。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby zmienić kolejność. Włącz lub wyłącz kartę. Karty, które nie mają jeszcze wartości, mają kreskę."
          }
        }
      }
    },
    "Drives your Fitness Age": {
      "localizations": {
        "de": {
