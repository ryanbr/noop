    "Scan connects to %@. To pair or switch bands, open Devices.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Scannen“ verbindet mit %@. Zum Koppeln oder Wechseln von Bändern öffne „Geräte“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar conecta con %@. Para emparejar o cambiar de banda, abre Dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanner se connecte à %@. Pour associer ou changer de bande, ouvrez Appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scansione si connette a %@. Per accoppiare o cambiare fascia, apri Dispositivi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A varredura liga-se a %@. Para emparelhar ou mudar de banda, abra Dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирование подключается к %@. Чтобы выполнить сопряжение или сменить браслет, откройте раздел «Устройства»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描会连接到 %@。要配对或切换手环，请打开「设备」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描會連接到 %@。要配對或切換手環，請打開「裝置」。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanowanie łączy się z %@. Aby sparować lub przełączyć pasma, otwórz Urządzenia."
          }
        }
      }
    },
