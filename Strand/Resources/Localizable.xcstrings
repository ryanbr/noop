    "In and out, but the band won more than it lost.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mal drin, mal draußen, aber der Zielbereich hat öfter gewonnen als verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dentro y fuera, pero la zona ganó más de lo que perdió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la zone et hors zone, mais la zone l'a emporté plus souvent qu'elle n'a perdu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dentro e fuori, ma la fascia ha vinto più di quanto abbia perso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra e sai, mas a banda ganhou mais do que perdeu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То в пределах диапазона, то нет — но чаще в пределах, чем нет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时进时出，但大部分时间仍保持在目标区间内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時進時出，但大部分時間仍保持在目標區間內。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wchodzi i wychodzi, ale zespół więcej wygrał niż przegrał."
          }
        }
      }
    },
