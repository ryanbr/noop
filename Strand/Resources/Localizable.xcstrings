          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones tradicionales son largas; aquí usa un temporizador corto solo como chequeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séances traditionnelles sont longues ; ici, un court minuteur suffit comme check-in."
          }
        },
        "pt-PT": {
