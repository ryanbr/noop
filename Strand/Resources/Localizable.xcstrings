    "Calibrating. Building your baseline. About %lld more nights until your scores are personal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibrierung. Deine Basislinie wird aufgebaut. Noch etwa %lld Nächte, bis deine Werte persönlich sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrando. Construyendo tu línea base. Faltan unas %lld noches para que tus puntuaciones sean personales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibration. Construction de votre référence. Encore environ %lld nuits avant que vos scores soient personnalisés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrazione. Creazione della tua linea di base. Ancora circa %lld notti prima che i tuoi punteggi siano personalizzati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A calibrar. A construir a tua linha de base. Cerca de %lld mais noites até que a tua pontuação seja pessoal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Калибровка. Формирование нормы. Осталось около %lld ночей до того, как оценки станут персональными."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校准中。正在建立你的基线。大约还需 %lld 晚，你的分数就会个性化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "校準中。正在建立你的基線。大約還需 %lld 晚，你的評分才會變得個人化。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibracja. Budowanie swojej linii bazowej. O %lld jeszcze więcej nocy, aż Twoje wyniki będą osobiste."
          }
        }
      }
    },
    "Calibrating. Building your baseline. About 1 more night until your scores are personal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibrierung. Deine Basislinie wird aufgebaut. Noch etwa 1 Nacht, bis deine Werte persönlich sind."
