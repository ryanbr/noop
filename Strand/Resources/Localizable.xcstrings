    "Take over your ring locally. Beta. This replaces the Oura app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernimm deinen Ring lokal. Beta. Das ersetzt die Oura-App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma el control de tu anillo localmente. Beta. Esto reemplaza la app de Oura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez le contrôle de votre anneau localement. Bêta. Ceci remplace l'app Oura."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendi il controllo del tuo anello in locale. Beta. Sostituisce l'app Oura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Assuma o controlo do teu anel localmente. Beta. Isto substitui o aplicativo Oura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возьмите управление кольцом на себя локально. Бета. Это заменяет приложение Oura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本地接管你的戒指。测试版。这会取代 Oura 应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在本地接管你的戒指。Beta。這會取代 Oura 應用程式。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejmij swój pierścień lokalnie. Beta. Zastępuje aplikację Oura."
          }
        }
      }
    },
    "Takes effect on the next analytics pass (after the next sync).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirkt beim nächsten Analysedurchlauf (nach der nächsten Synchronisierung)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Surte efecto en el próximo pase de análisis (tras la próxima sincronización)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend effet lors de la prochaine analyse (après la prochaine synchronisation)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha effetto alla prossima elaborazione analitica (dopo la prossima sincronizzazione)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra em vigor na passagem de análise seguinte (após a sincronização seguinte)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вступит в силу при следующем расчёте аналитики (после следующей синхронизации)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将在下一次分析处理时生效（在下次同步之后）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將在下一次分析處理時生效（在下次同步之後）。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obowiązuje od następnego przebiegu analiz (po następnej synchronizacji)."
          }
        }
      }
    },
