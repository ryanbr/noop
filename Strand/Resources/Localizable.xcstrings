    "Edit how the coach thinks and talks. Takes effect on your next message.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeite, wie der Coach denkt und spricht. Wirkt ab deiner nächsten Nachricht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita cómo piensa y habla el coach. Se aplica en tu próximo mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez la façon dont le coach pense et parle. Prend effet à votre prochain message."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica come il Coach ragiona e parla. Ha effetto dal tuo prossimo messaggio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
