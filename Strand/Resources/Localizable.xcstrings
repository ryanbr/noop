      }
    },
    "Never practice in water or while driving. Stop if dizzy. Not medical advice.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never practice in water or while driving. Stop if dizzy. Not medical advice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie im Wasser oder beim Fahren üben. Bei Schwindel stoppen. Keine medizinische Beratung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca practiques en el agua ni conduciendo. Para si te mareas. No es consejo médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pratiquez jamais dans l’eau ni en conduisant. Arrêtez si vertige. Pas un avis médical."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca pratiques na água nem a conduzir. Para se tiveres tonturas. Não é aconselhamento médico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non praticare in acqua né alla guida. Fermati se hai vertigini. Non è un consiglio medico."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nigdy nie ćwicz w wodzie ani podczas jazdy. Przerwij przy zawrotach. To nie porada medyczna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не практикуйте в воде или за рулём. Остановитесь при головокружении. Не медицинский совет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切勿在水中或驾驶时练习。头晕即停。非医疗建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切勿在水中或駕駛時練習。頭暈即停。非醫療建議。"
          }
        }
      }
    },
    "Skip if pregnant, dizzy, or have uncontrolled hypertension. Stop if strained.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip if pregnant, dizzy, or have uncontrolled hypertension. Stop if strained."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überspringen bei Schwangerschaft, Schwindel oder unkontrolliertem Bluthochdruck. Bei Überanstrengung stoppen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sáltarlo si estás embarazada, mareada o con hipertensión no controlada. Para si te esfuerzas de más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez si grossesse, vertige ou hypertension non contrôlée. Arrêtez si vous forcez."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta se estiveres grávida, com tonturas ou hipertensão não controlada. Para se te estiveres a forçar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta se in gravidanza, con vertigini o ipertensione non controllata. Fermati se forzi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomiń w ciąży, przy zawrotach lub niekontrolowanym nadciśnieniu. Przerwij przy forsowaniu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропустите при беременности, головокружении или неконтролируемой гипертонии. Остановитесь при перенапряжении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "孕期、头晕或未控制高血压时跳过。感觉勉强即停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "孕期、頭暈或未控制高血壓時跳過。感覺勉強即停。"
          }
        }
      }
    },
    "Not recommended as a beginner default unless the goal is to overcome drowsiness.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not recommended as a beginner default unless the goal is to overcome drowsiness."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Anfänger-Standard nicht empfohlen, außer Ziel ist, Müdigkeit zu durchbrechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No recomendado como valor por defecto para principiantes salvo que el objetivo sea superar la somnolencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non recommandé comme défaut débutant sauf si le but est de vaincre la somnolence."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não recomendado como padrão para principiantes, salvo se o objetivo for ultrapassar a sonolência."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non consigliato come default per principianti salvo che l’obiettivo sia superare la sonnolenza."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niezalecane jako domyślne dla początkujących, chyba że celem jest przebicie senności."
